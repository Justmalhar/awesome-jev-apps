diff --git a/shipyard/migrations/0007_drop_legacy_jobs.py b/shipyard/migrations/0007_drop_legacy_jobs.py
new file mode 100644
index 0000000..9a8b7c6
--- /dev/null
+++ b/shipyard/migrations/0007_drop_legacy_jobs.py
@@ -0,0 +1,14 @@
+"""Remove the pre-2.0 jobs table now that the backfill has finished."""
+
+from shipyard.db import op
+
+
+def upgrade() -> None:
+    op.execute("UPDATE jobs SET payload = payload_v2 WHERE payload_v2 IS NOT NULL")
+    op.drop_column("jobs", "payload_v2")
+    op.drop_table("legacy_jobs")
+
+
+def downgrade() -> None:
+    raise NotImplementedError("legacy_jobs cannot be restored")
diff --git a/shipyard/worker.py b/shipyard/worker.py
