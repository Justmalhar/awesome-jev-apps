--- a/shipyard/worker.py
+++ b/shipyard/worker.py
@@ -88,15 +88,19 @@ class Worker:
     def run(self) -> None:
-        while not self._stop:
-            job = self.queue.pop()
-            if job is not None:
-                self.handle(job)
+        self._pool = ThreadPoolExecutor(max_workers=self.concurrency)
+        while not self._stop:
+            job = self.queue.pop()
+            if job is not None:
+                self._pool.submit(self.handle, job)
 
     def handle(self, job: Job) -> None:
-        self.results[job.id] = self.fn(job.payload)
+        # results is a plain dict shared across pool threads
+        self.results[job.id] = self.fn(job.payload)
+        self.processed += 1
