# Copy to .env and fill in ONE of these, matching `provider` in providers.toml.
# .env is gitignored. Never commit a real key.

# provider = "typesafe"  (default)
TYPESAFE_API_KEY=

# provider = "openrouter"  — works with credits you already have on OpenRouter
OPENROUTER_API_KEY=

# Optional: override providers.toml without editing it
# JEV_PROVIDER=openrouter

# provider = "vercel"  — Vercel AI Gateway
#   vercel ai-gateway api-keys create --name my-api-key
AI_GATEWAY_API_KEY=
